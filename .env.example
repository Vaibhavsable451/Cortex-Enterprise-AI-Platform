# ---- LLM (Groq) ----
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
# ---- Vector DB (Pinecone) ----
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=enterprise-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# set to faiss to run fully local without Pinecone
VECTOR_BACKEND=pinecone
# ---- Embeddings (local, 384-dim) ----
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# ---- Security ----
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=admin123
ANALYST_PASSWORD=analyst123
RATE_LIMIT_PER_MIN=20
RISK_APPROVAL_THRESHOLD=0.7
# ---- DB (sqlite locally, MySQL in docker) ----
DATABASE_URL=sqlite:///./data/audit.db
MLFLOW_TRACKING_URI=./mlruns
API_URL=http://localhost:8000
